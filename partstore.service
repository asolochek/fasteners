# systemd unit for Partstore. Install:  sudo cp partstore.service /etc/systemd/system/ && sudo systemctl enable --now partstore
[Unit]
Description=Partstore (fastener cabinets and their labels)
After=network.target

[Service]
User=aarons
WorkingDirectory=/usr/local/share/partstore
Environment=PORT=8093
ExecStart=/usr/bin/node /usr/local/share/partstore/server.js
Restart=on-failure

[Install]
WantedBy=multi-user.target
